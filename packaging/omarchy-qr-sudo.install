post_install() {
  systemd-sysusers --replace=/usr/lib/sysusers.d/omarchy-qr-sudo.conf >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl reset-failed omarchy-qr-sudod.service >/dev/null 2>&1 || true
  systemctl enable --now omarchy-qr-sudod.service >/dev/null 2>&1 || true
  echo "Parent Approve is installed. Daemon should be running."
  echo "As the parent:"
  echo "  sudo omarchy-qr-sudo enable"
  echo "  sudo omarchy-qr-sudo pair"
  echo "  sudo omarchy-qr-sudo setup-kid <kid-username>"
  echo "Rebuild with makepkg -f -si so pacman does not reuse a stale tarball."
}

post_upgrade() {
  systemd-sysusers --replace=/usr/lib/sysusers.d/omarchy-qr-sudo.conf >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable omarchy-qr-sudod.service >/dev/null 2>&1 || true
  systemctl reset-failed omarchy-qr-sudod.service >/dev/null 2>&1 || true
  systemctl restart omarchy-qr-sudod.service >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl disable --now omarchy-qr-sudod.service >/dev/null 2>&1 || true
}
