[Unit]
Description=Omarchy parent-approval daemon
Documentation=file:///usr/share/doc/omarchy-parentapproval/README.md
Documentation=file:///usr/share/omarchy-parentapproval/agents/skills/parentapproval/SKILL.md
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=10

[Service]
Type=simple
ExecStart=/usr/bin/parentapproval daemon
Restart=on-failure
RestartSec=1
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
RuntimeDirectory=omarchy-parentapproval
RuntimeDirectoryMode=0755
StateDirectory=omarchy-parentapproval
StateDirectoryMode=0700
PrivateTmp=true

[Install]
WantedBy=multi-user.target
