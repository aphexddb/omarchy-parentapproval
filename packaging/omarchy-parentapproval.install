post_install() {
  systemd-sysusers --replace=/usr/lib/sysusers.d/omarchy-parentapproval.conf >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl reset-failed omarchy-parentapprovald.service >/dev/null 2>&1 || true
  systemctl enable --now omarchy-parentapprovald.service >/dev/null 2>&1 || true
  echo "Parent Approval is installed. Daemon should be running."
  echo "As the parent:"
  echo "  sudo omarchy-parentapproval enable"
  echo "  omarchy-parentapproval pair"
  echo "  sudo omarchy-parentapproval setup-kid <kid-username>"
  echo "  omarchy-parentapproval install-skills"
  echo "Test without a kid account:"
  echo "  omarchy-parentapproval ask --cmd \"pacman -S cowsay\""
  echo "Rebuild with makepkg -f -si so pacman does not reuse a stale tarball."
}

post_upgrade() {
  systemd-sysusers --replace=/usr/lib/sysusers.d/omarchy-parentapproval.conf >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable omarchy-parentapprovald.service >/dev/null 2>&1 || true
  systemctl reset-failed omarchy-parentapprovald.service >/dev/null 2>&1 || true
  systemctl restart omarchy-parentapprovald.service >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl disable --now omarchy-parentapprovald.service >/dev/null 2>&1 || true
}
