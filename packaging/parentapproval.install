migrate_legacy_state() {
  if [ -d /var/lib/omarchy-parentapproval ] && [ ! -e /var/lib/parentapproval ]; then
    mv /var/lib/omarchy-parentapproval /var/lib/parentapproval
  fi
  systemctl disable --now omarchy-parentapprovald.service >/dev/null 2>&1 || true
  rm -f /usr/lib/systemd/system/omarchy-parentapprovald.service
  rm -f /usr/lib/sysusers.d/omarchy-parentapproval.conf
  rm -rf /usr/share/omarchy-parentapproval /usr/share/doc/omarchy-parentapproval /usr/share/licenses/omarchy-parentapproval
}

_systemd_live() {
  [ -d /run/systemd/system ]
}

post_install() {
  systemd-sysusers /usr/lib/sysusers.d/parentapproval.conf >/dev/null 2>&1 || true
  migrate_legacy_state
  if _systemd_live; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl reset-failed parentapprovald.service >/dev/null 2>&1 || true
    systemctl enable --now parentapprovald.service >/dev/null 2>&1 || true
  fi
  echo "Parent Approval is installed. Daemon should be running."
  echo "As the parent:"
  echo "  sudo parentapproval enable"
  echo "  sudo parentapproval pair"
  echo "  sudo parentapproval setup-kid <kid-username>"
  echo "  sudo parentapproval install-skills"
  echo "Test without a kid account:"
  echo "  parentapproval ask --cmd \"pacman -S cowsay\""
}

post_upgrade() {
  systemd-sysusers /usr/lib/sysusers.d/parentapproval.conf >/dev/null 2>&1 || true
  migrate_legacy_state
  if _systemd_live; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable parentapprovald.service >/dev/null 2>&1 || true
    systemctl reset-failed parentapprovald.service >/dev/null 2>&1 || true
    systemctl restart parentapprovald.service >/dev/null 2>&1 || true
  fi
}

pre_remove() {
  if _systemd_live; then
    systemctl disable --now parentapprovald.service >/dev/null 2>&1 || true
    systemctl disable --now omarchy-parentapprovald.service >/dev/null 2>&1 || true
  fi
}
