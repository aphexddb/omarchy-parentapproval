#!/bin/bash
# Build the Arch package from this checkout and install it with pacman.
# Overlay plugin is copied into the parent's Omarchy config.
# Undo with scripts/dev-uninstall.
set -euo pipefail

cd "$(dirname "$0")/.."

if (( EUID == 0 )); then
  echo "dev-install: do not run makepkg as root; pacman will ask for sudo." >&2
  exit 1
fi

echo "Building and installing parentapproval (sudo for pacman)."
if [[ ${PARENTAPPROVAL_SKIPCHECK:-} == 1 ]]; then
  makepkg -fsi --noconfirm --nocheck
else
  makepkg -fsi --noconfirm
fi

plugin_dst=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/parentapproval
mkdir -p "$plugin_dst"
install -m644 overlay/manifest.json overlay/Panel.qml "$plugin_dst/"
rm -f "$plugin_dst/qmldir"
# QML treats parent.approve as parent.approve property access; that id never maps a layer.
old_plugin=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/parent.approve
if command -v omarchy >/dev/null; then
  omarchy plugin disable parent.approve >/dev/null 2>&1 || true
fi
rm -rf "$old_plugin" "$old_plugin.bak"

# Third-party overlays are off until they appear in shell.json plugins[].
# omarchy-shell rescan is async, so a single `plugin enable` right after copy
# returns unknown and used to be swallowed — pair then had no Hyprland QR.
enable_overlay_plugin() {
  local shell_json=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json
  if [[ -f $shell_json ]] && command -v python3 >/dev/null; then
    python3 - "$shell_json" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
plugins = data.get("plugins")
if not isinstance(plugins, list):
    plugins = []
    data["plugins"] = plugins
ids = []
for e in plugins:
    ids.append(str(e.get("id", "") if isinstance(e, dict) else e))
if "parentapproval" not in ids:
    plugins.append({"id": "parentapproval"})
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
PY
  fi
  if ! command -v omarchy-shell >/dev/null || ! command -v omarchy >/dev/null; then
    return 0
  fi
  local i
  for i in 1 2 3 4 5 6; do
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    if omarchy plugin enable parentapproval >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.3
  done
  return 1
}

if ! enable_overlay_plugin; then
  echo "dev-install: overlay plugin is installed but omarchy-shell did not enable it." >&2
  echo "  Run:  omarchy plugin enable parentapproval && omarchy restart shell" >&2
fi
if [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json ]] &&
   ! grep -q '"parentapproval"' "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"; then
  echo "dev-install: shell.json is missing parentapproval — Hyprland QR will not show." >&2
  exit 1
fi

echo
echo "Installed /usr/bin/parentapproval and overlay plugin:"
echo "  $plugin_dst"
echo
if ! /usr/bin/parentapproval status; then
  echo "dev-install: status failed; is parentapprovald running?" >&2
  exit 1
fi
echo
echo "Next:"
echo "  sudo /usr/bin/parentapproval pair"
echo "  sudo /usr/bin/parentapproval setup-kid <kid-username>"
echo "  /usr/bin/parentapproval ask -c \"pacman -S cowsay\""
echo
echo "This checkout's bin/ may shadow PATH. Use /usr/bin/parentapproval."
echo "Remove with:  $(dirname "$0")/dev-uninstall"
echo "Restart the shell so the overlay loads: omarchy restart shell"
